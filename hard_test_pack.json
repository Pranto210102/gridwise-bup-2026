{
  "metadata": {
    "title": "GridWise Production-Level Hard Test Pack",
    "version": "1.0.0",
    "purpose": "Hidden-style semantic interpretation and downstream constraint validation; not an official judge set.",
    "case_count": 10,
    "interpretation_policy": "Exactly one directive_interpretation entry per operator note. A note containing multiple clauses is deliberately excluded except where a manual variant is documented, because the canonical specification requires exactly one directive per note.",
    "tolerance": {
      "kwh": 0.01,
      "bdt": 0.01
    },
    "required_api": "POST /optimize-energy",
    "runner_guidance": [
      "Send only each input object to the API.",
      "Compare returned interpretations to expected_directive_interpretation semantically, not by explanation text.",
      "Replay hourly_plan against effective solar, every directive, battery limits, energy balance, and final neutrality.",
      "Do not compare against a fixed schedule or hard-code these notes; generate/solve a valid optimal plan.",
      "For cases with tight constraints, reject any plan that violates a directive even if its cost is lower."
    ]
  },
