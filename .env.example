# GridWise Configuration Template

# Server Port (default: 8000)
PORT=8000

# LLM Provider: 'gemini', 'groq', or 'openai' (optional, auto-detects based on available key)
LLM_PROVIDER=gemini

# Google Gemini API Key (Single key or comma-separated keys for concurrent load rotation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# Groq API Key (Alternative for ultra-fast latency)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
